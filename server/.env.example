# Copy this file to .env and add your key locally. Never commit .env.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
PORT=3001
# Comma-separated browser origins. Keep this explicit in production.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
